# ── Supabase (required) ──────────────────────────────────────
VITE_SUPABASE_URL=https://qdaqskqpgwflnramneyd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_JkfAZFyiki1_WWEcXxtgpg_bqhbq8WQ

# ── Supabase Secrets (set via CLI, NOT in this file) ─────────
# supabase secrets set ALPACA_API_KEY=...
# supabase secrets set ALPACA_SECRET_KEY=...
# SUPABASE_SERVICE_ROLE_KEY is automatically injected into edge functions

# ── Optional: Alpaca Markets (real-time stock data) ──────────
# If not set, update-stock-prices function uses price simulation instead.
# Get free keys at https://alpaca.markets (Paper Trading account)
# ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX
# ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google OAuth (required for Google Sign-In) ────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# You need TWO OAuth 2.0 Client IDs:
#   1. Type: Web application  → used for web OAuth redirect + as Supabase provider
#   2. Type: Android          → used for native Google Sign-In in Capacitor (SHA-1 fingerprint required)
# Also enable Google provider in Supabase Dashboard → Authentication → Providers → Google
VITE_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# VITE_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
